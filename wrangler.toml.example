name = "zero-ad"
main = "src/index.ts"
compatibility_date = "2024-02-21"
compatibility_flags = ["nodejs_compat"]

# Replace with your Cloudflare Account ID
account_id = "YOUR_KV_NAMESPACE_ID"

# KV Namespace Binding
[[kv_namespaces]]
binding = "ADBLOCK_KV"
id = "YOUR_KV_NAMESPACE_ID"

[vars]
# Internal name for API calls
SCRIPT_NAME = "zero-ad"
# List Source URLs (Comma-separated)
ADBLOCK_LIST_URLS = "https://raw.githubusercontent.com/sander85/uBO-et/main/list.txt,https://small.oisd.nl"
# Maximum items per list (Free: 1000, Enterprise: 5000)
MAX_ITEMS_PER_LIST = 1000
# Prefix for Gateway Lists created by this worker
LIST_PREFIX = "AdBlock_Worker_"
# Maximum number of lists to manage (Free limit is ~100 lists total)
MAX_LISTS = 90
CLOUDFLARE_ACCOUNT_ID = "YOUR_ACCOUNT_ID"

[observability]
enabled = true
head_sampling_rate = 1

[observability.logs]
enabled = true
head_sampling_rate = 1

